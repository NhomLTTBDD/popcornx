rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if user is admin
    function isAdmin() {
      return isAuthenticated() && 
             firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Thumbnails folder - only admins can upload
    match /thumbnails/{fileName} {
      // Everyone can read thumbnails (for mobile app)
      allow read: if true;
      
      // Only admins can upload thumbnails
      allow write: if isAdmin() && 
                      request.resource.size < 5 * 1024 * 1024 && // 5MB max
                      request.resource.contentType.matches('image/.*');
    }

    // Videos folder - only admins can upload
    match /videos/{fileName} {
      // Everyone can read videos (for mobile app)
      allow read: if true;
      
      // Only admins can upload videos
      allow write: if isAdmin() && 
                      request.resource.size < 500 * 1024 * 1024 && // 500MB max
                      request.resource.contentType.matches('video/.*');
    }

    // Deny all other access
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
